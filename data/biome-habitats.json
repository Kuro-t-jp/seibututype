{
  "environments": {
    "canyon": {
      "label": "乾いた岩礫地",
      "description": "乾燥・日なた。淡水池や海水域ではありません。"
    },
    "waterside": {
      "label": "淡水の池と岸辺",
      "description": "淡水・止水と周辺の草地。海水の生物は置けません。"
    },
    "highland": {
      "label": "冷涼な山地・高山",
      "description": "冷涼な草地や岩場。寒冷な場所の生物を中心に配置します。"
    },
    "rivergravel": {
      "label": "淡水の河原",
      "description": "流れる淡水と礫地・岸辺。海岸の砂浜とは区別します。"
    },
    "satoyama": {
      "label": "温帯の里山・田畑",
      "description": "林縁・畑・田んぼや淡水の小池を含みます。栽培・飼育の学習種もここで扱います。"
    },
    "oasis": {
      "label": "温暖な乾燥地と淡水",
      "description": "乾燥した陸地と暖かい淡水の小さな水場。海水ではありません。"
    },
    "coast": {
      "label": "海岸の砂浜・砂丘",
      "description": "潮風・砂地。淡水池ではなく、海浜植物と砂浜の動物の場所です。"
    },
    "limestone": {
      "label": "温帯の石灰岩地",
      "description": "日なたの岩地と草地・疎林を含みます。"
    },
    "stream": {
      "label": "冷涼な淡水の渓流",
      "description": "流水と湿った岸辺。池や海とは異なる環境です。"
    },
    "deciduousfloor": {
      "label": "温帯の落葉広葉樹林",
      "description": "林床から林縁・林冠のすき間までを含めた森林として扱います。"
    },
    "volcanic": {
      "label": "温帯の火山性荒原",
      "description": "日なたの岩礫地。陸上の遷移の初期を考える場所です。"
    },
    "peat": {
      "label": "泥炭湿原",
      "description": "冷涼で湿った貧栄養の湿原。土を豊かにするほどよいとは限りません。"
    },
    "coniferfloor": {
      "label": "亜寒帯・亜高山の針葉樹林",
      "description": "冷涼な針葉樹林。林床・林縁も含みます。"
    },
    "evergreenfloor": {
      "label": "暖温帯の照葉樹林",
      "description": "暖かく湿潤な常緑広葉樹林。林床・林縁も含みます。"
    },
    "savanna": {
      "label": "熱帯・亜熱帯の疎林",
      "description": "乾季のある草原とまばらな樹木の景観です。"
    },
    "rainforestfloor": {
      "label": "熱帯・亜熱帯の湿潤林",
      "description": "暖かく湿潤な林。温帯や寒冷地の樹種とは区別します。"
    },
    "mangrovecoast": {
      "label": "暖かい沿岸の潮間帯",
      "description": "潮汐と塩分の影響を受ける泥地。淡水の池とは区別します。"
    },
    "tidalflat": {
      "label": "海水・汽水の干潟",
      "description": "潮汐で水に浸かったり干出したりする砂泥底。ヨシは陸寄りの汽水域として扱います。"
    },
    "tundra": {
      "label": "寒冷地のツンドラ",
      "description": "高木の森林が成立しにくい寒冷地。低い植物を中心にします。"
    },
    "snowmelt": {
      "label": "冷涼な雪解けの谷",
      "description": "高山の草地や岩場、湿った場所。暖地の生物は置けません。"
    }
  },
